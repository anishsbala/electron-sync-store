{
  "name": "@electron-sync-store/react",
  "version": "0.0.0",
  "description": "React hooks for electron-sync-store renderer replicas",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@electron-sync-store/renderer": "workspace:*",
    "use-sync-external-store": "^1.6.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@electron-sync-store/core": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/use-sync-external-store": "^1.5.0",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "engines": {
    "node": ">=20"
  }
}
