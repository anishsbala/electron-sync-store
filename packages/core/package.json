{
  "name": "@electron-sync-store/core",
  "version": "0.1.0",
  "description": "Typed shallow state primitives and synchronization protocol for electron-sync-store",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "electron",
    "state-management",
    "typescript",
    "ipc",
    "synchronization"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anishsbala/electron-sync-store.git"
  },
  "homepage": "https://github.com/anishsbala/electron-sync-store#readme",
  "bugs": {
    "url": "https://github.com/anishsbala/electron-sync-store/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
