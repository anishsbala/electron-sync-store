{
  "name": "electron-sync-store-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm --recursive build",
    "demo": "pnpm build && electron examples/demo",
    "smoke:electron": "pnpm build && electron tests/electron-smoke/main.mjs",
    "test": "vitest run",
    "typecheck": "pnpm --filter @electron-sync-store/core build && pnpm --recursive typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "electron": "^44.1.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  }
}
