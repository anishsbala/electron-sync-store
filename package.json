{
  "name": "electron-sync-store-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --recursive build",
    "demo": "pnpm build && electron examples/demo",
    "smoke:electron": "pnpm build && electron tests/electron-smoke/main.mjs",
    "smoke:demo": "pnpm build && node examples/demo/scripts/run-smoke.mjs",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "typecheck": "pnpm --filter=./packages/* build && pnpm --recursive typecheck && tsc --project tsconfig.e2e.json --noEmit",
    "verify:packages": "pnpm build && node scripts/verify-packages.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.3.0",
    "electron": "^44.1.0",
    "playwright": "^1.62.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  },
  "license": "MIT"
}
